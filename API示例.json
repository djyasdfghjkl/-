      "name": "获取广场日记",
      "method": "GET",
      "path": "/api/diaries/square",
      "description": "获取广场的公开日记",
      "authRequired": true,
      "query": {
        "page": 1,
        "pageSize": 10,
        "type": "推荐"
      }
    },
    {
      "name": "使用兑换码",
      "method": "POST",
      "path": "/api/redeem/use",
      "description": "使用兑换码获取相应权益",
      "authRequired": true,
      "body": {
        "code": "REDEEM_CODE_HERE"
      }
    },
    {
      "name": "生成兑换码（管理员）",
      "method": "POST",
      "path": "/api/admin/redeem/generate",
      "description": "管理员生成兑换码",
      "authRequired": true,
      "adminRequired": true,
      "body": {
        "type": "vip",
        "value": 30,
        "count": 5,
        "expireDays": 30
      }
    },
    {
      "name": "获取兑换码列表（管理员）",
      "method": "GET",
      "path": "/api/admin/redeem/codes",
      "description": "管理员获取所有兑换码",
      "authRequired": true,
      "adminRequired": true,
      "query": {
        "type": "vip",
        "isUsed": false
      }
    },
    {
      "name": "充值VIP",
      "method": "POST",
      "path": "/api/recharge/vip",
      "description": "充值VIP会员",
      "authRequired": true,
      "body": {
        "duration": 30
      }
    },
    {
      "name": "充值SVIP",
      "method": "POST",
      "path": "/api/recharge/svip",
      "description": "充值SVIP会员",
      "authRequired": true,
      "body": {
        "duration": 30
      }
    },
    {
      "name": "充值余额",
      "method": "POST",
      "path": "/api/recharge/balance",
      "description": "充值账户余额",
      "authRequired": true,
      "body": {
        "amount": 100
      }
    },
    {
      "name": "获取充值记录",
      "method": "GET",
      "path": "/api/recharge/records",
      "description": "获取当前用户的充值记录",
      "authRequired": true
    },
    {
      "name": "上传文件",
      "method": "POST",
      "path": "/api/files/upload",
      "description": "上传文件",
      "authRequired": true,
      "formData": {
        "file": "/path/to/your/file.jpg",
        "description": "文件描述",
        "type": "user_image"
      }
    },
    {
      "name": "获取用户上传的文件",
      "method": "GET",
      "path": "/api/files",
      "description": "获取当前用户上传的文件列表",
      "authRequired": true
    },
    {
      "name": "获取当前用户的勋章列表",
      "method": "GET",
      "path": "/api/medals/user",
      "description": "获取当前用户已获得的所有勋章",
      "authRequired": true
