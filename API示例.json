    {
      "name": "获取日记列表",
      "method": "GET",
      "path": "/api/diaries",
      "description": "获取当前用户的日记列表",
      "authRequired": true,
      "query": {
        "page": 1,
        "per_page": 10
      }
    },
    {
      "name": "创建日记",
      "method": "POST",
      "path": "/api/diaries",
      "description": "创建新的日记",
      "authRequired": true,
      "body": {
        "title": "我的第一篇日记",
        "content": "今天天气真好！",
        "diary_date": "2026-03-14",
        "weather": "晴天",
        "mood": "开心",
        "location": "北京",
        "tags": ["生活", "日常"]
      }
    },
    {
      "name": "创建日记（兼容格式）",
      "method": "POST",
      "path": "/api/diaries",
      "description": "创建日记的另一种参数格式",
      "authRequired": true,
      "body": {
        "title": "等一下",
        "content": "你好\n\n爱睡觉跟大家说大好时机",
        "date": "2026-03-14T08:17:49.532Z",
        "emotion": 0,
        "location": "11",
        "tags": "工作"
      }
    },
    {
      "name": "获取日记详情",
      "method": "GET",
      "path": "/api/diaries/{id}",
      "description": "获取指定日记的详细信息",
      "authRequired": true
    },
    {
      "name": "更新日记",
      "method": "PUT",
      "path": "/api/diaries/{id}",
      "description": "更新指定日记的信息",
      "authRequired": true,
      "body": {
        "title": "更新后的标题",
        "content": "更新后的内容"
      }
    },
    {
      "name": "删除日记",
      "method": "DELETE",
      "path": "/api/diaries/{id}",
      "description": "删除指定日记",
      "authRequired": true
    },
