{
  "baseUrl": "http://localhost:3000",
  "description": "API接口示例文件",
  "endpoints": [
    {
      "name": "测试连接",
      "method": "GET",
      "path": "/api/test",
      "description": "测试接口是否正常工作"
    },
    {
      "name": "用户登录",
      "method": "POST",
      "path": "/api/users/login",
      "description": "用户登录获取JWT令牌",
      "body": {
        "email": "test@example.com",
        "password": "123456"
      }
    },
    {
      "name": "用户注册",
      "method": "POST",
      "path": "/api/users/register",
      "description": "创建新用户账号",
      "body": {
        "email": "newuser@example.com",
        "password": "123456",
        "nickname": "新用户",
        "code": "123456"
      }
    },
    {
      "name": "发送验证码",
      "method": "POST",
      "path": "/api/users/send-code",
      "description": "发送验证码到指定邮箱",
      "body": {
        "email": "user@example.com",
        "type": "register"
      }
    },
    {
      "name": "获取用户信息",
      "method": "GET",
      "path": "/api/users/profile",
      "description": "获取当前登录用户的个人信息",
      "authRequired": true
    },
    {
      "name": "更新用户信息",
      "method": "PUT",
      "path": "/api/users/profile",
      "description": "更新当前登录用户的个人信息",
      "authRequired": true,
      "body": {
        "nickname": "新昵称",
        "avatar": "https://example.com/avatar.jpg"
      }
    },
    {
      "name": "重置密码",
      "method": "POST",
      "path": "/api/users/reset-password",
      "description": "使用验证码重置密码",
      "body": {
        "email": "user@example.com",
        "code": "123456",
        "newPassword": "newpassword123"
      }
    },
    {
      "name": "微信登录",
      "method": "POST",
      "path": "/api/users/wechat-login",
      "description": "使用微信code登录",
      "body": {
        "code": "WECHAT_CODE_HERE"
      }
    },
    {
      "name": "微信绑定",
      "method": "POST",
      "path": "/api/users/wechat-bind",
      "description": "绑定微信账号到当前用户",
      "authRequired": true,
      "body": {
        "code": "WECHAT_CODE_HERE"
      }
    },
    {
      "name": "获取用户统计",
      "method": "GET",
      "path": "/api/users/stats",
      "description": "获取当前用户的统计数据",
      "authRequired": true
